# =============================================================================
# TradePilot AI - Environment Configuration
# Copy this file to .env and fill in values. NEVER commit .env
# =============================================================================

# Application
APP_NAME=TradePilot AI
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Database (PostgreSQL)
POSTGRES_USER=tradepilot
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=tradepilot
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://tradepilot:change-me-strong-password@db:5432/tradepilot

# Redis (optional, for caching / agent state)
REDIS_URL=redis://redis:6379/0

# JWT / Auth
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# Market Data Provider
# Supported: alpha_vantage | finnhub | polygon | mock
MARKET_DATA_PROVIDER=mock
ALPHA_VANTAGE_API_KEY=
FINNHUB_API_KEY=
POLYGON_API_KEY=

# Rate limiting / retries
MARKET_DATA_RATE_LIMIT_PER_MINUTE=5
MARKET_DATA_TIMEOUT_SECONDS=30
MARKET_DATA_MAX_RETRIES=3

# Paper Trading
PAPER_STARTING_CASH=100000.00
PAPER_DEFAULT_COMMISSION=0.0

# Agent
AGENT_LOOP_INTERVAL_SECONDS=60
AGENT_DEFAULT_SYMBOLS=AAPL,MSFT,GOOGL,SPY,QQQ

# AI Analysis (optional - leave empty to use rule-based fallback)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AI_ENABLED=false

# Risk defaults (overridable in UI / DB)
RISK_MAX_POSITION_PCT=10.0
RISK_MAX_PORTFOLIO_EXPOSURE_PCT=80.0
RISK_MAX_RISK_PER_TRADE_PCT=2.0
RISK_MAX_DAILY_LOSS_PCT=5.0
RISK_MAX_DRAWDOWN_PCT=15.0
RISK_MAX_OPEN_POSITIONS=10
RISK_REQUIRE_STOP_LOSS=true
RISK_TRADE_COOLDOWN_SECONDS=300
RISK_MAX_TRADES_PER_DAY=20

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Frontend (Vite)
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000/ws
